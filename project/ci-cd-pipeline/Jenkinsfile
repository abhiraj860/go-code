pipeline {
    agent any

    environment {
        IMAGE_NAME   = "arbiter-lite"
        REGISTRY     = credentials('registry-url')       // e.g. docker.io/yourorg
        REGISTRY_CRED = 'docker-registry-creds'
        GIT_SHA      = "${GIT_COMMIT.take(7)}"
    }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Lint & Static Analysis') {
            steps {
                sh 'go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest'
                sh '$(go env GOPATH)/bin/golangci-lint run ./...'
                sh 'go install github.com/securego/gosec/v2/cmd/gosec@latest'
                sh '$(go env GOPATH)/bin/gosec ./... || true'
            }
        }

        stage('Unit Tests') {
            steps {
                sh 'go test ./... -v -coverprofile=coverage.out'
                sh 'go tool cover -func=coverage.out'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'test-results/*.xml'
                }
            }
        }

        stage('Build Image') {
            steps {
                sh "docker build -t ${REGISTRY}/${IMAGE_NAME}:${GIT_SHA} ."
            }
        }

        stage('Scan Image') {
            steps {
                sh "trivy image --severity CRITICAL,HIGH --exit-code 1 ${REGISTRY}/${IMAGE_NAME}:${GIT_SHA}"
            }
        }

        stage('Push Image') {
            when { branch 'main' }
            steps {
                withCredentials([usernamePassword(credentialsId: env.REGISTRY_CRED, usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh "echo $PASS | docker login ${REGISTRY} -u $USER --password-stdin"
                    sh "docker push ${REGISTRY}/${IMAGE_NAME}:${GIT_SHA}"
                }
            }
        }

        stage('Deploy (GitOps sync)') {
            when { branch 'main' }
            steps {
                sh """
                  sed -i "s|image: .*${IMAGE_NAME}:.*|image: ${REGISTRY}/${IMAGE_NAME}:${GIT_SHA}|" deploy/k8s/deployment.yaml
                  git config user.email 'jenkins@ci'
                  git config user.name 'jenkins-bot'
                  git commit -am "deploy: update image to ${GIT_SHA}" || true
                  git push origin HEAD:main
                """
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded — image ${IMAGE_NAME}:${GIT_SHA} deployed via ArgoCD sync"
        }
        failure {
            echo "Pipeline failed — no deploy triggered, previous ArgoCD-synced version remains live"
        }
    }
}
