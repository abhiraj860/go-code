# Compiled binaries
/bin/
*.exe

# Go workspace sum file is machine-local; go.work itself IS committed so every
# clone resolves the modules identically.
go.work.sum

# Generated protobuf code is deliberately NOT ignored -- it is committed and CI
# verifies it is not stale. See .github/workflows/ticketflow-ci.yml.

# Node
node_modules/
.next/
out/
*.tsbuildinfo
.pnpm-store/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Local env / secrets
.env
.env.local
*.pem

# Test & coverage output
coverage.out
coverage.html
*.test

# Editor
.DS_Store
.idea/
*.swp
